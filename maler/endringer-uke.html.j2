{# Endringssiden for én uke — og for én type i den uka.

   SAMME MAL FOR BEGGE. `valgt` er typen når dette er en typeside og
   `none` når det er hele uka. To maler ville vært to steder å rette
   den samme setningen.

   FILTERET ER STIER, IKKE EN SPØRRESTRENG. Hver type er en EKTE side,
   bygget ved bygging, og avkrysningsboksene er lenker dit uten
   JavaScript. Med JavaScript filtreres tabellen på stedet og flere
   typer kan velges samtidig — det er forbedringen, og den er nettopp
   det en spørrestreng ikke kan gi uten en server. Se avvik 5 i
   oppdraget og 2026-09-16-url-struktur.md punkt 3.

   PERMANENT SIDE PER UKE. Adressen `/endringer/2026-39/` betyr uke 39
   av 2026 for alltid; innholdet er en sammenligning av to
   øyeblikksbilder som begge er append-only. #}
{% extends "base.html.j2" %}

{% block toppinnhold %}
<div data-pagefind-body class="ark sidehode">
  <nav class="sti" aria-label="Du er her">
    <ol>
      <li><a href="/">Forside</a></li>
      <li><a href="/endringer/">Endringer</a></li>
      {% if valgt %}
      <li><a href="/endringer/{{ u.slug }}/">{{ u.vist }}</a></li>
      <li aria-current="page">{{ valgt.navn }}</li>
      {% else %}
      <li aria-current="page">{{ u.vist }}</li>
      {% endif %}
    </ol>
  </nav>

  {# UKENAVIGASJONEN. «Eldre» og «nyere», ikke «forrige» og «neste»:
     lista er sortert nyest først, og to ord som betyr det motsatte av
     hva rekkefølgen gjør er en feil som ser riktig ut. #}
  <nav class="ukenav" aria-label="Uker">
    {% if eldre %}
    <a href="/endringer/{{ eldre.slug }}/">← {{ eldre.vist }}</a>
    {% else %}
    <span class="mangler">← ingen eldre uke</span>
    {% endif %}
    <a href="/endringer/">{{ alle(uker_totalt, "uka", "ukene") }}</a>
    {% if nyere %}
    <a href="/endringer/{{ nyere.slug }}/">{{ nyere.vist }} →</a>
    {% else %}
    <span class="mangler">nyeste uke</span>
    {% endif %}
  </nav>

  <h1>
    {% if valgt %}{{ valgt.navn }} i {{ u.vist }}
    {% else %}Endringer i {{ u.vist }}{% endif %}
  </h1>
  <p class="lok-undertittel">
    {{ u.merke }}. Permalenke:
    {# VERTSNAVNET KOMMER FRA KONFIGURASJONEN, ikke fra malen: en
       forhåndsvisning skal ikke oppgi en permalenke som ikke serverer
       innholdet. `kanonisk` er siden selv. #}
    <span class="tall-mono">{{ kanonisk|replace("https://", "") }}</span>
  </p>
</div>
{% endblock %}

{% block innhold %}

<section class="ark seksjon">
  <div class="uke-sammendrag uke-sammendrag--bred">
    {% if valgt %}
    <p>{{ rader|length }} av {{ antall(u.antall_rader, "rad", "rader") }} i {{ u.vist }} er
      {{ valgt.navn|lower }} — {{ valgt.hva }}.</p>
    {% else %}
    <p>{{ antall(u.antall, "endring", "endringer") }} observert i {{ u.vist }}:
      {{ u.ledet_slag }}.</p>
    {% endif %}
    {# DE TO TALLENE ER IKKE DET SAMME, og forskjellen skjules ikke.
       «Felt oppgitt første gang» og «Felt ikke lenger oppgitt» er
       opplysninger om hva KILDEN rapporterer, ikke om hva som skjedde
       i havbruket, og de telles derfor ikke i tallet over. De står i
       tabellen. #}
    {% if u.utenfor_tellingen and not valgt %}
    <p class="tabellnote">
      {{ antall(u.utenfor_tellingen, "rad", "rader") }} til står i tabellen uten å telle
      med: de sier at kilden begynte eller sluttet å oppgi et felt om en
      oppføring, ikke at noe skjedde med oppføringen.
      {% if u.antall_egen_del %}
      {{ antall(u.antall_egen_del, "endring", "endringer") }} i selskapsdata står lenger ned,
      i sin egen del.
      {% endif %}
    </p>
    {% endif %}
  </div>


  {# BRIKKENE ER FILTERET, med og uten JavaScript. Hver brikke er en
     lenke til `/endringer/<uke>/<type>/`, en ekte side bygget ved
     bygging.

     Fram til 24.09.2026 sto det en RAD MED AVKRYSNINGSBOKSER over, som
     skriptet slo på og som da skjulte brikkene. To filtre for det samme
     er ett for mye, og det ene som forsvant uten JavaScript var det som
     så ut som et skjema. Brikkene virker overalt. #}
  <ul class="typemerker"
      aria-label="Endringstyper i {{ u.vist }}">
    <li>
      <a class="typemerke{% if not valgt %} typemerke--valgt{% endif %}"
         href="/endringer/{{ u.slug }}/">
        Alle <span class="typemerke-tall">{{ tall(u.antall_rader) }}</span> rader
      </a>
    </li>
    {% for k in u.typer %}
    <li>
      <a class="typemerke{% if not k.antall %} typemerke--tom{% endif %}{% if valgt and valgt.id == k.id %} typemerke--valgt{% endif %}"
         href="/endringer/{{ u.slug }}/{{ k.id }}/" title="{{ k.hva }}">
        {{ k.navn }} <span class="typemerke-tall">{{ tall(k.antall) }}</span>
      </a>
    </li>
    {% endfor %}
  </ul>

  {#- TALLET ER FAST. `data-teller` ble skrevet om av filterskriptet, som
      er borte fra 24.09.2026 — brikkene er filteret, og hver brikke er
      en egen bygget side. «Viser N av N» var da en omvei til N. #}
  <p class="tabelltittel" id="endringer-uke-tittel">{{ antall(rader|length,
      "rad", "rader") }}
      {% if valgt %}{% else %}utenom selskapsdata{% endif %}
      i {{ u.vist }}.</p>
  <div class="tabellramme" role="region"
       aria-labelledby="endringer-uke-tittel" tabindex="0">
  <table id="endringer-uke" aria-labelledby="endringer-uke-tittel">
    <thead>
      <tr>
        <th scope="col">Observert</th>
        <th scope="col">Gjelder</th>
        <th scope="col">Kommune</th>
        <th scope="col">Produksjonsområde</th>
        <th scope="col">Type</th>
        <th scope="col">Endring</th>
      </tr>
    </thead>
    <tbody>
      {% for r in rader %}
      <tr data-type="{{ r.type }}">
        <td data-felt="observed_at"><time datetime="{{ r.dato }}">{{ r.dato }}</time></td>
        <td class="gjelder" data-felt="{{ r.gjelder_felt }}">
          {%- if r.gjelder_url %}<a href="{{ r.gjelder_url }}" data-felt="{{ r.gjelder_felt }}">{{ r.gjelder }}</a>
          {%- else %}{{ r.gjelder or VERDI_MANGLER }}{% endif %}
        </td>
        <td data-felt="{{ feltmerke(r.kommune, 'kommune') }}">{{ r.kommune or VERDI_MANGLER }}</td>
        <td data-felt="{{ feltmerke(r.po, 'prodomraade_kode') }}">
          {%- if r.po %}<a href="/produksjonsomrade/{{ r.po }}/">{{ r.po }} {{ r.po_navn }}</a>
          {%- else %}{{ VERDI_MANGLER }}{% endif %}
        </td>
        <td data-felt="endringstype">{{ r.type_navn }}</td>
        <td class="endring {{ r.til_klasse }}" data-felt="endringstekst">{{ r.etikett }}:
          <span data-felt="{{ r.fra_felt }}">{{ r.fra }}</span>
          <span class="pil" aria-label="ble til">→</span>
          <span data-felt="{{ r.til_felt }}">{{ r.til }}</span></td>
      </tr>
      {% endfor %}
      {# TOMRADEN står når det ikke er rader. Den var `hidden` og ble
         slått på av filterskriptet; nå finnes ikke skriptet, og raden
         skrives bare når tabellen faktisk er tom. Uten den ville en tom
         tabell sett ut som en feil. #}
      {% if not rader %}
      <tr data-tom>
        <td colspan="6" data-felt="tomtekst">
          {% if valgt %}Ingen {{ valgt.navn|lower }} i {{ u.vist }}.
          {% else %}Ingen endringer i {{ u.vist }}. Alle felt står som
          de sto forrige gang vi spurte.{% endif %}
        </td>
      </tr>
      {% endif %}
    </tbody>
  </table>
  </div>

  {# SELSKAPSDATA, I SIN EGEN DEL.
     `<details open>` og ikke `hidden`: uten JavaScript står den ÅPEN,
     og skriptet lukker den. En del som må åpnes av et skript er en del
     som ikke finnes for den som har skript av. Se avvik 5 og
     `maler/kystloggen.js`. #}
  {% if egen %}
  <details class="egen-del" open data-lukk-ved-js>
    <summary>
      <span class="egen-del-tall">{{ egen|length }}</span>
      {{ "endring" if egen|length == 1 else "endringer" }} i selskapsdata
    </summary>
    <p class="tabellnote">
      Ansatte, næringskode, adresse, regnskap, kapital og konkurs fra
      Enhetsregisteret. Radene er ekte — de er kontrollert mot
      Brønnøysunds egne svar — men de er løpende registervedlikehold og
      ikke hendelser i havbruket, og de telles derfor ikke i tallet
      over. MÅLT uke 39: 369 av 402 var antall ansatte, som oppdateres
      månedlig for alle selskaper samtidig.
    </p>
    <p class="tabelltittel" id="endringer-selskapsdata-tittel">{{ alle(egen|length, "selskapsdataendringen", "selskapsdataendringene") }} i {{ u.vist }}.</p>
    <div class="tabellramme" role="region"
         aria-labelledby="endringer-selskapsdata-tittel" tabindex="0">
    <table id="endringer-selskapsdata" aria-labelledby="endringer-selskapsdata-tittel">
      <thead>
        <tr>
          <th scope="col">Observert</th>
          <th scope="col">Gjelder</th>
          <th scope="col">Kommune</th>
          <th scope="col">Endring</th>
        </tr>
      </thead>
      <tbody>
        {% for r in egen %}
        <tr data-type="{{ r.type }}">
          <td data-felt="observed_at"><time datetime="{{ r.dato }}">{{ r.dato }}</time></td>
          <td class="gjelder" data-felt="{{ r.gjelder_felt }}">
            {%- if r.gjelder_url %}<a href="{{ r.gjelder_url }}" data-felt="{{ r.gjelder_felt }}">{{ r.gjelder }}</a>
            {%- else %}{{ r.gjelder or VERDI_MANGLER }}{% endif %}
          </td>
          <td data-felt="{{ feltmerke(r.kommune, 'kommune') }}">{{ r.kommune or VERDI_MANGLER }}</td>
          <td class="endring" data-felt="endringstekst">{{ r.etikett }}:
            <span data-felt="{{ r.fra_felt }}">{{ r.fra }}</span>
            <span class="pil" aria-label="ble til">→</span>
            <span data-felt="{{ r.til_felt }}">{{ r.til }}</span></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    </div>
  </details>
  {% endif %}

  <p class="tabellnote">
    <strong>«Observert»</strong> er datoen vi så endringen i
    øyeblikksbildet, ikke datoen registeret gjorde den. Registeret
    oppgir ikke det siste, så endringen kan ha skjedd når som helst i
    uka før.
    {% if u.utenfor_uka %}
    {{ antall(u.utenfor_uka, "endring", "endringer") }} står utenfor ukesregnskapet fordi
    kilden daterer dem til perioden de HANDLER OM og ikke til dagen vi
    hentet dem — forskriftsrunder, journalførte overføringer og
    månedlige beholdningstall. De står på entitetenes egne sider.
    {% endif %}
  </p>

  <p class="nedlasting">
    Last ned uka:
    <a href="/endringer/{{ u.slug }}/endringer.csv">CSV</a> ·
    <a href="/endringer/{{ u.slug }}/endringer.json">JSON</a> ·
    <a href="/endringer/feed.xml">Atom-feed</a>
    <span class="nedlasting-note">Begge filene har alle
      {{ antall(u.antall_rader, "raden", "radene") }} i uka, ikke bare de som vises her.</span>
  </p>
</section>

<section class="ark" id="siter" aria-labelledby="siter-tittel">
  <div class="siterboks">
    <div class="siterboks-hode">
      <h2 id="siter-tittel">Siter denne uka</h2>
      <button class="knapp kopierknapp" type="button"
              data-kopier="siterbar" hidden>Kopier</button>
    </div>
    <p class="siterbar" id="siterbar">Kystloggen ({{ siter.aar }}).
      <i>Endringer i norske akvakulturregistre, {{ siter.uke }}.</i>
      {{ siter.spenn }},
      sjekksum {{ siter.sjekksum[:8] }}…{{ siter.sjekksum[-4:] }}.
      {{ siter.url }}</p>
    <p class="siterboks-note">
      Adressen er permanent: {{ siter.uke }} betyr den uka for alltid.
      Innholdet er en sammenligning av to øyeblikksbilder som begge er
      append-only, så siden kan bygges opp igjen fra kilden.
    </p>
  </div>
</section>
{% endblock %}
