{# Produksjonsområdeindeksen. Tretten rader, nyeste farge. #}
{% extends "base.html.j2" %}
{% import "marg.html.j2" as marg %}

{% block toppinnhold %}
<div data-pagefind-body class="ark sidehode">
<nav class="sti" aria-label="Du er her">
  <ol>
    <li><a href="/">Forside</a></li>
    <li aria-current="page">Produksjonsområder</li>
  </ol>
</nav>
</div>
{% endblock %}

{% block innhold %}
{# TABELLEN OG KARTET VED SIDEN AV HVERANDRE, som på forsiden, men med
   kartet i høyrespalta (stil.css avsnitt 11b). Tittelen står i gitteret,
   så kartet starter på høyde med den. #}
<div class="med-marg">
<div class="med-marg-hoved">
<h1>Alle produksjonsområder</h1>
<p class="historikk-forklaring">{{ antall(d.antall, "produksjonsområde", "produksjonsområder") }}, fastsatt i forskrift.</p>
{% for s in d.uten_omraade.split("\n") if s %}<p class="historikk-forklaring">{{ s }}</p>
{% endfor %}
<p class="historikk-forklaring">Fargen er fra siste runde. Hver områdeside viser alle.</p>
<p class="historikk-forklaring">{{ antall(d.uten_po, "lokalitet", "lokaliteter") }} hører ikke til noe område. De står i
  <a href="/lokalitet/">lokalitetslista</a>.</p>

<p class="tabelltittel" id="trafikklysvedtak-alle-tittel">Produksjonsområdene med nyeste trafikklysfarge, hentet
    <time datetime="{{ d.akva_dato }}">{{ d.akva_dato }}</time>.</p>
<div class="tabellramme" role="region"
     aria-labelledby="trafikklysvedtak-alle-tittel" tabindex="0">
<table id="trafikklysvedtak-alle" aria-labelledby="trafikklysvedtak-alle-tittel">
  <thead>
    <tr>
      <th scope="col">Område</th>
      <th scope="col">Navn</th>
      <th scope="col">Lokaliteter</th>
      <th scope="col">Nyeste runde</th>
      <th scope="col">Farge</th>
      <th scope="col">Lesemåte</th>
    </tr>
  </thead>
  <tbody>
    {% for r in d.rader %}
    <tr>
      <th scope="row"><a href="/produksjonsomrade/{{ r.nr }}/">{{ r.nr }}</a></th>
      <td class="eier" data-felt="prodomraade_navn">{{ r.navn }}</td>
      <td class="tall" data-felt="lokaliteter_antall">{{ tall(r.lokaliteter) }}</td>
      <td data-felt="runde"><time datetime="{{ r.siste_runde }}">{{ r.siste_runde }}</time></td>
      <td{% if r.farge_klasse %} class="{{ r.farge_klasse }}"{% endif %} data-felt="{{ r.farge_felt }}">{{ r.farge }}</td>
      <td data-felt="farge__lesemaate">{{ r.lesemaate }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
</div>
</div>

{# KARTET. Hvert område er en lenke til områdesiden, og navnet og fargen
   står i tipset og i lenkas navn. Fyllet er cella i «Farge»-kolonnen;
   et område uten farge i nyeste runde er stiplet, som i stripa. #}
{% set klasser = {} %}{% set navn = {} %}
{% for r in d.rader %}
{% set _ = klasser.update({r.nr: r.farge_klasse or "omraade--skravert"}) %}
{% set _ = navn.update({r.nr: r.navn ~ ", " ~ r.farge}) %}
{% endfor %}
<div class="marg" data-pagefind-ignore>
  <section class="marg-blokk" aria-labelledby="marg-kart">
    <h2 class="etikett" id="marg-kart">Fargen langs kysten</h2>
    {% call marg.minikart(d.kart, "minikart-po",
         "Kart over de " ~ d.antall ~ " produksjonsområdene",
         "Hvert område er fylt med fargen fra nyeste fastsatte runde, som i
          tabellen ved siden av, og er en lenke til områdesiden.",
         klasser=klasser, lenker=True, navn=navn) -%}
      Fargen er den nyeste fastsatte runden, som i tabellen.
    {%- endcall %}
  </section>
</div>
</div>
{% endblock %}
