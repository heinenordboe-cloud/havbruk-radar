{# Alle endringsuker. Flat liste, ingen paginering — som de tre andre
   indekssidene: dette er siden en crawler og en språkmodell følger for
   å finne ukene, og en paginert liste er en liste der side 14 aldri
   blir lest.

   TALLET ER LITE, OG DET SKJULES IKKE. Fem uker er fem uker. Se avvik
   9 i oppdraget: et arkiv som later som det er eldre enn det er, er
   verdiløst den dagen noen sjekker. #}
{% extends "base.html.j2" %}
{% import "marg.html.j2" as marg %}

{% block toppinnhold %}
<div data-pagefind-body class="ark sidehode">
  <nav class="sti" aria-label="Du er her">
    <ol>
      <li><a href="/">Forside</a></li>
      <li aria-current="page">Endringer</li>
    </ol>
  </nav>
</div>
{% endblock %}

{% block innhold %}
{# TOPPEN I TO SPALTER, tabellen i full bredde under (stil.css avsnitt
   11b). Krysstabellen har en kolonne per type og trenger plassen; det
   som sto alene over den — tittel og forklaring — får høyrespalta ved
   siden av seg: nyeste uke, ukene som diagram og analysen. #}
<div class="ark med-marg">
<div class="med-marg-hoved">
  <h1>Endringer, uke for uke</h1>
  <p class="lok-undertittel">
    {{ antall(uker|length, "uke", "uker") }} med observerte endringer ·
    {{ antall(totalt, "hendelse", "hendelser") }} til sammen
  </p>
  <ul class="handlinger" aria-label="Følg">
    <li><a class="handling" href="/endringer/feed.xml">Følg alle
      endringer (feed)</a></li>
  </ul>
  <p class="historikk-forklaring">
    Hver uke vi har hentet registrene og sammenlignet med forrige
    øyeblikksbilde. <strong>Datoen er når VI så endringen</strong> —
    registeret oppgir ikke når det gjorde den.
    {% if utenfor %}
    {{ antall(utenfor, "endring", "endringer") }} står utenfor dette regnskapet fordi kilden
    daterer dem til perioden de HANDLER OM og ikke til dagen vi hentet
    dem: forskriftsrunder dateres til vedtaksåret, journalførte
    overføringer til journalåret, og biomassetall til månedsslutt. De
    står på entitetenes egne sider.
    {% endif %}
  </p>
  {% if uker %}
  {# NYESTE UKE, som en «videre»-lenke: det er den de fleste kommer for. #}
  <a class="videre" href="/endringer/{{ uker[0].slug }}/">Se nyeste uke,
    {{ uker[0].vist }}: {{ antall(uker[0].antall, "endring", "endringer") }} →</a>
  {% endif %}
</div>

<div class="marg" data-pagefind-ignore>
  {% if diagram.rader %}
  {# DIAGRAMMET. Hver rad er en type, hver stolpe en uke, eldst til
     venstre; én skala for alle. Det sier ingenting tabellen under ikke
     sier, og er derfor `aria-hidden` med tallene i tabellen som
     tekstalternativ — se `nettsted.ukediagram()`. #}
  <section class="marg-blokk" aria-labelledby="marg-diagram">
    <h2 class="etikett" id="marg-diagram">Per uke og type</h2>
    <figure class="ukediagram">
      <ol>
        {% for r in diagram.rader %}
        <li>
          <span>{{ r.navn }}</span>
          <svg viewBox="0 0 {{ diagram.bredde }} {{ diagram.hoyde }}"
               width="{{ diagram.bredde }}" height="{{ diagram.hoyde }}"
               aria-hidden="true">
            {%- for s in r.soyler %}{% if s.h %}<rect x="{{ s.x }}" y="{{ s.y }}" width="{{ diagram.stolpe }}" height="{{ s.h }}"/>{% endif %}{% endfor -%}
          </svg>
          <span class="fordeling-tall">{{ tall(r.sum) }}</span>
        </li>
        {% endfor %}
      </ol>
      <figcaption>Én stolpe per uke, {{ diagram.forste }} til venstre og
        {{ diagram.siste }} til høyre. Hver rad har sin egen skala: den
        høyeste stolpen er radens største uke, og summen står ved siden
        av. Tallene står i tabellen under.</figcaption>
    </figure>
  </section>
  {% endif %}

</div>
</div>

<section class="ark seksjon">

  <p class="tabelltittel" id="endringer-uker-tittel">{{ alle(uker|length, "uka", "ukene") }}, nyeste først. Tallene per type
      lenker rett til uka filtrert på den typen.</p>
  <div class="tabellramme tabellramme--ruller" role="region"
       aria-labelledby="endringer-uker-tittel" tabindex="0">
  <table id="endringer-uker" aria-labelledby="endringer-uker-tittel">
    <thead>
      <tr>
        <th scope="col">Uke</th>
        <th scope="col">Datoer</th>
        <th scope="col" class="tall">Endringer</th>
        {% for k in typer %}
        <th scope="col" class="tall" title="{{ k.hva }}">{{ k.navn }}</th>
        {% endfor %}
      </tr>
    </thead>
    <tbody>
      {% for u in uker %}
      <tr>
        <th scope="row">
          <a href="/endringer/{{ u.slug }}/">{{ u.vist }}</a>
        </th>
        <td data-felt="observed_at">
          {% for d in u.datoer %}<time datetime="{{ d }}">{{ d }}</time>{% if not loop.last %}, {% endif %}{% endfor %}
        </td>
        <td class="tall" data-felt="antall">
          <a href="/endringer/{{ u.slug }}/" data-felt="antall">{{ tall(u.antall) }}</a>
        </td>
        {% for k in u.typer %}
        <td class="tall{% if not k.antall %} mangler{% endif %}"
            data-felt="{{ k.id }}">
          {%- if k.antall %}<a href="/endringer/{{ u.slug }}/{{ k.id }}/" data-felt="{{ k.id }}">{{ tall(k.antall) }}</a>
          {%- else %}0{% endif %}
        </td>
        {% endfor %}
      </tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
  <p class="tabellnote">
    En type med 0 er ikke en lenke.
  </p>

  <h2>Hva slagene betyr</h2>
  <dl class="grader">
    {% for k in typer %}
    <dt>{{ k.navn }}</dt>
    <dd>{{ k.hva }}</dd>
    {% endfor %}
  </dl>
  <p>
    Slaget er utledet av hvilken kilde og hvilket felt raden kom fra.
    Et felt som ikke er klassifisert, faller til «Annet».
  </p>
</section>
{% endblock %}
