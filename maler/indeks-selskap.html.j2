{# Selskapsindeksen, sortert på navn og delt i sider på 100 — se
   indeks-lokalitet.html.j2 for hvorfor. #}
{% extends "base.html.j2" %}
{% import "marg.html.j2" as marg %}

{% block toppinnhold %}
<div data-pagefind-body class="ark sidehode">
<nav class="sti" aria-label="Du er her">
  <ol>
    <li><a href="/">Forside</a></li>
    <li aria-current="page">Selskaper</li>
  </ol>
</nav>
</div>
{% endblock %}

{% block innhold %}
{# TO SPALTER FRA 64rem, som lokalitetsindeksen: lista til venstre, de
   største og ukas bevegelse til høyre. Se stil.css avsnitt 11b. #}
<div class="med-marg">
<div class="med-marg-hoved">
{# «INNEHAVERE», IKKE «SELSKAPER». Lista er bygget av hvem som EIER en
   tillatelse i eierskapsregisteret, ikke av hvem som er et selskap: et
   selskap i næringskodeuttrekket vårt uten tillatelse står ikke her.
   Menyen sier fortsatt «Selskaper» — det er navnet på rommet, og en
   meny som byttet ord ville flyttet en URL i leserens hode. #}
<h1>Alle innehavere av akvakulturtillatelse</h1>
<p class="lok-undertittel">
  {{ antall(d.antall, "selskap", "selskaper") }} eier minst én tillatelse i eierskapsøyeblikksbildet
  <time datetime="{{ d.eierskap_dato }}">{{ d.eierskap_dato }}</time>.
</p>
{# SØKET, øverst på hver side i lista. Samme skjema som /sok/: det
   søker i hele nettstedet, ikke bare på denne siden, og uten
   JavaScript viser /sok/ veien til lista. #}
<form class="sok sok--side" action="/sok/" method="get" role="search">
  <label for="q">Søk etter selskap, lokalitet eller kommune</label>
  <input id="q" name="q" type="search" autocomplete="off"
         placeholder="Søk etter selskap, lokalitet eller kommune">
  <button class="knapp" type="submit">Søk</button>
</form>

{% if d.side and d.side.antall > 1 %}
<p class="historikk-forklaring">
  Lista er delt i {{ antall(d.side.antall, "side", "sider") }},
  sortert på navn. Søkefeltet øverst søker i alle.
</p>
{% endif %}
<p class="historikk-forklaring">
  {{ d.uten_registerdata }} av dem har vi ingen registerdata
  for. Uttrekket vårt fra Enhetsregisteret er avgrenset til et
  sett næringskoder, og et selskap som eier en tillatelse uten å ha en av
  dem faller utenfor. De har side likevel, og siden sier hva som mangler.
</p>
{% if d.personeiere %}
<p class="historikk-forklaring">
  {{ d.personeiere }} eier(e) står ikke i lista og har ingen
  side. Kilden klassifiserer dem som person — et partrederi
  eller en annen personlig sammenslutning — og verken dette nettstedet
  eller datagrunnlaget bak det skal være et personregister.
  Tillatelsene deres står på lokalitetssidene sine, uten eiernavn.
</p>
{% endif %}

{% set sidenav_etikett = "Sidene i selskapslista" %}
{% include "sidenav.html.j2" %}

<p class="tabelltittel" id="eierskap-selskaper-tittel">Selskapene, sortert på navn.</p>
<div class="tabellramme" role="region"
     aria-labelledby="eierskap-selskaper-tittel" tabindex="0">
<table id="eierskap-selskaper" aria-labelledby="eierskap-selskaper-tittel" data-pagefind-ignore>
  <thead>
    <tr>
      <th scope="col">Organisasjonsnummer</th>
      <th scope="col">Navn</th>
      <th scope="col">Tillatelser</th>
      <th scope="col">Lokaliteter</th>
      <th scope="col">Registerdata</th>
    </tr>
  </thead>
  <tbody>
    {% for r in d.rader %}
    <tr>
      <th scope="row"><a href="/selskap/{{ r.orgnr }}/">{{ r.orgnr }}</a></th>
      <td class="eier" data-felt="eier_navn">{{ r.navn|selskapsnavn }}</td>
      <td class="tall" data-felt="tillatelser_antall">{{ r.tillatelser }}</td>
      <td class="tall" data-felt="lokaliteter_antall">{{ tall(r.lokaliteter) }}</td>
      <td data-felt="har_registerdata">{{ "ja" if r.har_registerdata else "nei" }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
</div>
{% include "sidenav.html.j2" %}
<p class="tabellnote">
  Organisasjonsnummeret er Brønnøysundregistrenes og er nøkkelen til
  selskapssiden.
</p>
</div>

{# HØYRESPALTA. Hvem som er størst, målt to måter, og hvor mange som har
   endret seg nylig. Like på hver side av lista: de gjelder alle. Ingen
   personeier kan stå her — radene er indeksens egne. #}
{% set m = d.marg %}
<div class="marg">
  {% if m.vindu %}
  <section class="marg-blokk" aria-labelledby="marg-endret">
    <h2 class="etikett" id="marg-endret">Siste {{ antall(m.vindu.uker, "uke", "uker") }}</h2>
    <dl class="fakta">
      <div>
        <dt>Selskaper med vesentlige endringer</dt>
        <dd>{{ tall(m.endret) }} <span class="fakta-bi">av {{ tall(d.antall) }},
          til <time datetime="{{ m.vindu.til }}">{{ m.vindu.til|dato }}</time>{% if not m.vindu.hele %},
          talt fra <time datetime="{{ m.vindu.fra }}">{{ m.vindu.fra|dato }}</time>{% endif %}</span></dd>
      </div>
    </dl>
    <p class="marg-note">Samme telling som på hver selskapsside: endringer
      på selskapets lokaliteter og tillatelser.
      <a href="/endringer/">Endringene uke for uke</a>.</p>
  </section>
  {% endif %}

  {% if m.tonn %}
  <section class="marg-blokk" aria-labelledby="marg-tonn">
    <h2 class="etikett" id="marg-tonn">Størst etter kapasitet</h2>
    {{ marg.fordeling(m.tonn, "marg-tonn") }}
    <p class="marg-note">Summen av tillatelsenes kapasitet i tonn.
      {{ antall(m.andre_enheter, "tillatelse", "tillatelser") }} har kapasitet i
      andre enheter — stykk, dekar, kilo — og er ikke med.</p>
  </section>
  {% endif %}

  {% if m.lokaliteter %}
  <section class="marg-blokk" aria-labelledby="marg-lok">
    <h2 class="etikett" id="marg-lok">Flest lokaliteter</h2>
    {{ marg.fordeling(m.lokaliteter, "marg-lok") }}
  </section>
  {% endif %}
</div>
</div>
{% endblock %}
