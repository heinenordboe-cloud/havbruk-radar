{
  "permissions": {
    "deny": [
      "Bash(wrangler*)",
      "Bash(npx wrangler*)",
      "Bash(npx --yes wrangler*)",
      "Bash(npx -y wrangler*)",
      "Bash(npm exec wrangler*)",
      "Bash(* wrangler *)",
      "Bash(*publiser.py*--produksjon*)",
      "Bash(git push*--force*)",
      "Bash(git push* -f*)",
      "Bash(git push* +*)",
      "Edit(.github/workflows/**)",
      "Bash(*.github/workflows*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "p=\"$CLAUDE_PROJECT_DIR/.venv/bin/python\"; [ -x \"$p\" ] || p=python3; \"$p\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/arkivvakt.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "p=\"$CLAUDE_PROJECT_DIR/.venv/bin/python\"; [ -x \"$p\" ] || p=python3; \"$p\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/persondatavakt.py\""
          }
        ]
      }
    ]
  }
}
